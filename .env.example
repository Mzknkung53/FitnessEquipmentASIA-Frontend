# Copy to .env.local and fill in from Supabase: Project Settings → API Keys.
# Without these the catalog is empty and the quote / repair forms are disabled.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (formerly "anon") — used on the server and in the browser for Auth.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional alias kept for older scripts; prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (formerly "service_role"): server only, used by the quote / repair forms. Never expose it.
SUPABASE_SECRET_KEY=
