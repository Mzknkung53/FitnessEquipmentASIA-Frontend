# Copy to .env.local and fill in from Supabase: Project Settings → API Keys.
# Without these the catalog is empty and the quote / repair forms are disabled.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (formerly "anon") — used on the server and in the browser for Auth.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional alias kept for older scripts; prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (formerly "service_role"): server only, used by the quote / repair forms. Never expose it.
SUPABASE_SECRET_KEY=

# --- Staff notifications for new quote / repair requests (optional; both can be on) ---
# Public site address used in notification links, e.g. https://www.example.com
SITE_URL=
# LINE Messaging API (LINE Official Account → Messaging API channel). LINE_NOTIFY_TO is the
# user ID (U...) or group ID (C...) that receives the message.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_NOTIFY_TO=
# Email through Resend (resend.com). NOTIFY_EMAIL_TO accepts several addresses, comma-separated.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
